<view class="page">
  <text class="eyebrow">DEVICE EXPORT / POC</text>
  <text class="title">本地导出验证</text>
  <view class="warning">只做裁剪和缩放，不抠图、不换底、不上传。测试图片不代表合格证件照，也不保证 DPI 或相册保存后的元数据。</view>
  <picker disabled="{{busy}}" range="{{presets}}" range-key="name" value="{{presetIndex}}" bindchange="changePreset">
    <view class="panel row"><text>{{presets[presetIndex].name}}</text><text>切换 ↓</text></view>
  </picker>
  <view class="canvas-wrap"><canvas id="photo" type="2d" class="photo" style="height:{{previewHeight}}px" /></view>
  <button class="primary" bindtap="choosePhoto" disabled="{{busy}}">{{hasPhoto ? '更换照片' : '选择照片'}}</button>
  <view wx:if="{{hasPhoto}}" class="panel">
    <text class="muted">缩放 {{zoom}}%</text>
    <slider disabled="{{busy}}" min="100" max="300" value="{{zoom}}" data-key="zoom" bindchange="changeTransform" activeColor="#244C3B" />
    <text class="muted">横向位置</text>
    <slider disabled="{{busy}}" min="0" max="100" value="{{panX}}" data-key="panX" bindchange="changeTransform" activeColor="#244C3B" />
    <text class="muted">纵向位置</text>
    <slider disabled="{{busy}}" min="0" max="100" value="{{panY}}" data-key="panY" bindchange="changeTransform" activeColor="#244C3B" />
    <button class="secondary" bindtap="reset" disabled="{{busy}}">重置构图</button>
    <button class="primary" bindtap="exportPhoto" disabled="{{busy}}" loading="{{busy}}">导出并验证文件</button>
  </view>
  <view wx:if="{{evidence}}" class="panel">
    <text class="section">临时文件校验通过</text>
    <text>{{evidence.width}} × {{evidence.height}} px · {{evidence.format}} · {{evidence.bytes}} bytes</text>
    <text class="muted">这是保存相册前的文件数据。相册保存后的实际文件与 DPI，需要真机另行验证。</text>
    <button class="primary" bindtap="save" disabled="{{busy}}">保存测试图片</button>
  </view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <button wx:if="{{permissionDenied}}" class="secondary" bindtap="openSettings">主动打开相册权限设置</button>
  <privacy-consent id="privacy" />
</view>

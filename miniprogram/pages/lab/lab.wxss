.canvas-wrap { display: flex; justify-content: center; margin: 30rpx 0; padding: 20rpx 0; background: #e8ede5; border-radius: 16rpx; }
.photo { width: 270px; height: 378px; max-width: 100%; }
.panel .section { margin-top: 0; }
.panel .muted { display: block; margin-top: 18rpx; }
.preset-detail { display: block; margin-top: 8rpx; color: #77867b; font-size: 22rpx; }
.repair-tools { margin-top: 20rpx; padding: 18rpx; border-radius: 12rpx; background: #f1f4ee; }
.repair-mode-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; }
.repair-mode-title { color: #23352e; font-size: 25rpx; font-weight: 600; }
.repair-mode-status { color: #526458; font-size: 22rpx; white-space: nowrap; }
.repair-mode-options { display: flex; gap: 10rpx; }
.repair-mode-button { display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; height: 82rpx; margin: 0; padding: 0 4rpx; box-sizing: border-box; border: 2rpx solid #c8d2c9; border-radius: 12rpx; background: #fff; color: #34463b; font-size: 23rpx; font-weight: 500; line-height: 1.2; white-space: nowrap; }
.repair-mode-button.selected { border-color: #244c3b; background: #244c3b; color: #fff; font-weight: 600; box-shadow: 0 4rpx 10rpx rgba(36, 76, 59, .18); }
.repair-check { margin-right: 5rpx; font-size: 21rpx; font-weight: 700; }
.repair-tools .repair-instruction { margin-top: 14rpx; color: #526458; font-size: 22rpx; }
.repair-tools .repair-size-label { margin-top: 12rpx; }
.export-section { display: block; margin-top: 34rpx !important; }
.byte-range { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.byte-input { flex: 1; min-width: 0; height: 76rpx; padding: 0 16rpx; border: 1rpx solid #e2e6df; border-radius: 10rpx; font-size: 25rpx; }
.cleanup-warning { margin-top: 24rpx; }

.photo { width: 270px; margin: 0 auto; display: block; }
.canvas-wrap { border-radius: 18rpx; overflow: hidden; background: #e6e9e2; margin: 28rpx 0; }
.upload { position: fixed; left: -10000px; top: 0; width: 1px; height: 1px; }
.connection-input { padding: 22rpx 0; border-bottom: 1rpx solid #dce2d7; }
.consent { display: block; padding: 24rpx 0; font-size: 25rpx; line-height: 1.7; }
.byte-range { display: flex; gap: 16rpx; margin-top: 20rpx; }
.byte-input { width: 50%; font-size: 25rpx; padding: 16rpx 0; border-bottom: 1rpx solid #dce2d7; }
.compare-modes { display: flex; gap: 10rpx; }
.compare-modes button { flex: 1; padding: 0 8rpx; font-size: 23rpx; }
.compare-modes .selected { background: #244c3b; color: #fff; }
.local-compare { margin-top: 26rpx; padding: 22rpx; border-radius: 14rpx; background: #f3f5f0; }
.local-compare .section { margin-top: 0; }
.local-compare .muted { display: block; margin-top: 12rpx; }
.processing-progress { margin: 24rpx 0; padding: 24rpx; border-radius: 18rpx; background: #edf2ea; }
.progress-heading { font-size: 26rpx; color: #244c3b; }
.progress-time { font-size: 22rpx; color: #667263; white-space: nowrap; margin-left: 12rpx; }
.progress-track { height: 10rpx; margin: 20rpx 0; border-radius: 10rpx; background: #d4dfd0; overflow: hidden; }
.progress-runner { width: 35%; height: 100%; border-radius: 10rpx; background: #244c3b; animation: matting-wait 1.6s linear infinite; }
.progress-steps { display: flex; justify-content: space-between; font-size: 21rpx; color: #6c7868; }
.step-current { color: #244c3b; font-weight: 600; }
.step-done { color: #467044; }
.progress-hint { display: block; margin-top: 16rpx; font-size: 23rpx; line-height: 1.6; color: #5d6b58; }
@keyframes matting-wait {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(290%); }
}

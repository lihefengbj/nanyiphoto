# Local development only; no real account credentials belong in this example.
NP_ENV=local
NP_DATABASE_URL=sqlite:///.data/tasks.sqlite3
NP_STORAGE_ROOT=.data/objects
NP_CATALOG_PATH=config/specs.example.json
NP_DEV_TOKEN=
NP_DEV_OWNER=local-developer
NP_MAX_UPLOAD_BYTES=4194304
NP_MAX_IMAGE_PIXELS=4194304
NP_QUEUE_CAPACITY=8
NP_TASK_TTL_SECONDS=600
NP_UPLOAD_TTL_SECONDS=300
NP_RESULT_TTL_SECONDS=600
# Model and real moderation are not connected. Readiness remains false.
